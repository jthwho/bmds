# BMDS checked-in configuration defaults.
# `sdkconfig` is generated from this file and is not checked in.

CONFIG_IDF_TARGET="esp32p4"

# --- Flash and partitions -----------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O at 80 MHz: the W25Q128JV-IQ has QE fixed on and the board wires IO2/IO3 to the P4's
# FLASH_WP/FLASH_HOLD (docs/HARDWARE.md). Twice DIO's rate for each cache miss to flash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A firmware switched to boots on probation and confirms itself (Update::confirm()); one that
# resets first is abandoned for the other (devplan/update.md §16). 128 bytes of the bootloader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- PSRAM (32 MB on the ESP32-P4NRW32 module) ---------------------------
# 200 MHz (devplan/psram.md): the display scans an RGB888 surface straight from
# PSRAM (devplan/display.md §5c), which 80 MHz can't feed. IDF lists 200 MHz as
# experimental: memtest soaks, a warm run and a 35-minute scan soak found 0 errors.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# The boot-time PSRAM memory test costs ~1.3 s of every boot.
CONFIG_SPIRAM_MEMTEST=n
# The log's history survives a reset in PSRAM's .noinit, with a panic's report (devplan/logging.md
# §9).
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# --- Console: USB-Serial/JTAG on the USB-C connector ----------------------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Compiler -------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# --- FreeRTOS -------------------------------------------------------------
# 1 ms tick so timeoutMs values are honoured at millisecond granularity.
CONFIG_FREERTOS_HZ=1000
# The shell `tasks` command (uxTaskGetSystemState). A few bytes per task.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Each task's CPU time (devplan/sysmon.md §3.1): counted on the ESP timer in 64 bits (never wraps)
# at each context switch, while sysmon/enable is on (bmds_stats wraps the port's clock).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# Thread-local pointer 1 holds a running program's state (bmds_loader), 2 the
# interrupt the task's blocking calls wake on (Interrupt::current()), 3 how many
# contended Mutexes have raised the task's priority (mutex.cpp).
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=4

# --- SD card ----------------------------------------------------------------
# Memory cards only: SDIO (IO cards) support is code BMDS has no use for.
CONFIG_SD_ENABLE_SDIO_SUPPORT=n

# A busy program is legitimate: the task watchdog doesn't expect the idle tasks to run
# (devplan/processes.md §3.11). The interrupt watchdog is unchanged.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# No flash auto-suspend (IDF's default): the caches are off during an erase or a write, so audio
# pauses for it. With it on, a cache read during a suspended erase or write faulted the reading
# core on this board, under load (devplan/update.md §16; the user's choice, 2026-10-14).
# CONFIG_SPI_FLASH_AUTO_SUSPEND is not set

# --- Internal RAM (devplan/foundation.md §9) ------------------------------------
# Nothing runs I2C with the cache off, and no IRAM interrupt starts or stops a GDMA channel
# (the crypto's ISR only signals; the display's DMA is the DW-GDMA): both stay in flash.
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n

# Update packages: the acceptance mode (keys/README.md). Dev accepts the in-repository dev key as
# well as the release keys; a release image sets CONFIG_BMDS_UPDATE_KEYS_RELEASE=y.
CONFIG_BMDS_UPDATE_KEYS_DEV=y

# The L2 cache (in front of the PSRAM) with 128-byte lines, not 64: streaming through the PSRAM
# fetches half as many lines. Doom's timedemo 55 -> 65 fps, PSRAM copies +69%, the card through
# the VFS +64%, drawing +20-39%; a random dependent load 6% slower (devplan/bench.md §19).
CONFIG_CACHE_L2_CACHE_LINE_128B=y
