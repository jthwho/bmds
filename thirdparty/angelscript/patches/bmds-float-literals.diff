diff -ruN a/source/as_config.h b/source/as_config.h
--- a/source/as_config.h
+++ b/source/as_config.h
@@ -197,6 +197,12 @@
 // If there is no 64 bit floating point type, then this constant can be defined
 // to treat double like normal floats.
 
+// AS_FLOAT_LITERALS (BMDS)
+// Decimal literals without a suffix (1.5, 2e3) are float rather than double, and a
+// d or D suffix (1.5d) makes a double. For CPUs whose FPU is single precision. An
+// integer passed where f(float) and f(double) both exist goes to f(float), and an
+// overload that would drop a real argument's fraction is the last chosen.
+
 // AS_X86
 // Use assembler code for the x86 CPU family
 
