+// BMDS: altered from AngelScript 2.38.0's add-on: no STL (the strings built with snprintf,
+// std::sort and the quadratic sorts replaced by a heapsort).
 
 BEGIN_AS_NAMESPACE
 
+// BMDS: sorts @p n elements in place in O(n log n): @p less(i, j) compares elements i and j,
+// @p swap(i, j) exchanges them (through CScriptArray::Swap, so the GC always sees every
+// reference).
+template <typename Less, typename Swap>
+static void HeapSort(asUINT n, Less less, Swap swap)
+{
+	if( n < 2 )
+		return;
+	auto sift = [&](asUINT root, asUINT size) {
+		for( ;; )
+		{
+			asUINT child = 2 * root + 1;
+			if( child >= size )
+				return;
+			if( child + 1 < size && less(child, child + 1) )
+				child++;
+			if( !less(root, child) )
+				return;
+			swap(root, child);
+			root = child;
+		}
+	};
+	for( asUINT i = n / 2; i-- > 0; )
+		sift(i, n);
+	for( asUINT last = n - 1; last > 0; last-- )
+	{
+		swap(0, last);
+		sift(0, last);
+	}
+}
