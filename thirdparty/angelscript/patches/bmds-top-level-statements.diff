+#ifdef AS_TOP_LEVEL_STATEMENTS
+// BMDS: a statement outside functions. It is parsed now for its extent and syntax, and kept
+// as its source range: the types it names may be declared further on, so the compiler parses
+// it again (ParseTopLevel) once they are known, as it does a function's body.
+void asCParser::ParseTopLevelStatement()
+{
+	sToken start;
+	GetToken(&start);
+	RewindTo(&start);
+
+	asCScriptNode *statement = ParseStatement();
+	if( statement )
+		statement->Destroy(engine);
+	if( isSyntaxError )
+		return;
+
+	asCScriptNode *n = CreateNode(snTopLevelStatement);
+	if( n == 0 ) return;
+	n->UpdateSourcePos(start.pos, sourcePos - start.pos);
+
+	if( topLevel == 0 )
+	{
+		topLevel = CreateNode(snStatementBlock);
+		if( topLevel == 0 )
+		{
+			n->Destroy(engine);
+			return;
+		}
+	}
+	topLevel->UpdateSourcePos(n->tokenPos, n->tokenLength);
+	topLevel->AddChildLast(n);
+}
+
+// BMDS: a type and a name, then '(': a function's declaration, if not a correct one (IsFuncDecl
+// failed), so the errors are the declaration's rather than a statement's
+bool asCParser::LooksLikeFuncDecl()
+{
+	sToken start;
+	GetToken(&start);
+	RewindTo(&start);
+
+	sToken t = start;
+	bool looks = false;
+	if( IsRealType(t.type) || t.type == ttIdentifier || t.type == ttAuto )
+	{
+		GetToken(&t);
+		for( ;; )
+		{
+			GetToken(&t);
+			if( t.type == ttScope )
+			{
+				GetToken(&t);
+				continue;
+			}
+			if( t.type == ttLessThan )
+			{
+				int depth = 1;
+				while( depth > 0 && t.type != ttEnd && t.type != ttEndStatement )
+				{
+					GetToken(&t);
+					if( t.type == ttLessThan ) depth++;
+					else if( t.type == ttGreaterThan ) depth--;
+					else if( t.type == ttBitShiftRight ) depth -= 2;
+					else if( t.type == ttBitShiftRightArith ) depth -= 3;
+				}
+				continue;
+			}
+			if( t.type == ttOpenBracket )
+			{
+				GetToken(&t);
+				continue;
+			}
+			if( t.type == ttHandle || t.type == ttAmp )
+				continue;
+			break;
+		}
+		if( t.type == ttIdentifier )
+		{
+			GetToken(&t);
+			looks = t.type == ttOpenParenthesis;
+		}
+	}
+	RewindTo(&start);
+	return looks;
+}
+
+// BMDS: a global variable declared among top-level statements with an initializer is
+// initialized at its place among them: a marker for each one, by its name's position.
+void asCParser::MarkTopLevelInits(asCScriptNode *decl)
+{
+	for( asCScriptNode *n = decl->firstChild ? decl->firstChild->next : 0; n; n = n->next )
+	{
+		if( n->nodeType != snIdentifier || n->next == 0 ||
+			(n->next->nodeType != snAssignment && n->next->nodeType != snArgList && n->next->nodeType != snInitList) )
+			continue;
+
+		asCScriptNode *init = CreateNode(snGlobalInit);
+		if( init == 0 ) return;
+		init->UpdateSourcePos(n->tokenPos, n->tokenLength);
+
+		if( topLevel == 0 )
+		{
+			topLevel = CreateNode(snStatementBlock);
+			if( topLevel == 0 )
+			{
+				init->Destroy(engine);
+				return;
+			}
+		}
+		topLevel->UpdateSourcePos(init->tokenPos, init->tokenLength);
+		topLevel->AddChildLast(init);
+	}
+}
+
+// BMDS: a block of only top-level statements and markers (the builder's top-level function)
+bool asCParser::IsTopLevel(asCScriptNode *block)
+{
+	return block && block->nodeType == snStatementBlock && block->firstChild &&
+		(block->firstChild->nodeType == snTopLevelStatement || block->firstChild->nodeType == snGlobalInit);
+}
+
+// BMDS: the top-level statements parsed again, now with the script's types known, into one
+// statement block (markers copied as they are)
+int asCParser::ParseTopLevel(asCScriptCode *in_script, asCScriptNode *in_topLevel)
+{
+	Reset();
+
+	checkValidTypes = true;
+	this->script = in_script;
+
+	scriptNode = CreateNode(snStatementBlock);
+	if( scriptNode == 0 ) return -1;
+	scriptNode->UpdateSourcePos(in_topLevel->tokenPos, in_topLevel->tokenLength);
+
+	for( asCScriptNode *n = in_topLevel->firstChild; n && !isSyntaxError; n = n->next )
+	{
+		if( n->nodeType == snGlobalInit )
+		{
+			asCScriptNode *init = CreateNode(snGlobalInit);
+			if( init == 0 ) return -1;
+			init->UpdateSourcePos(n->tokenPos, n->tokenLength);
+			scriptNode->AddChildLast(init);
+		}
+		else
+		{
+			SetPos(n->tokenPos);
+			asCScriptNode *statement = ParseStatement();
+			if( statement )
+				scriptNode->AddChildLast(statement);
+		}
+	}
+
+	if( isSyntaxError || errorWhileParsing )
+		return -1;
+
+	return 0;
+}
+#endif
