+// BMDS: the global variable of @p file whose name is at @p pos
+sGlobalVariableDescription *asCBuilder::GetTopLevelGlobal(asCScriptCode *file, size_t pos)
+{
+	asCSymbolTableIterator<sGlobalVariableDescription> it = globVariables.List();
+	for( ; it; it++ )
+	{
+		sGlobalVariableDescription *gvar = *it;
+		if( gvar->script == file && gvar->declaredAtNode && gvar->declaredAtNode->tokenPos == pos )
+			return gvar;
+	}
+	return 0;
+}
+#endif
