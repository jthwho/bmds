+int asCBuilder::RegisterTopLevel(asCScriptNode *node, asCScriptCode *file, asSNameSpace *ns)
+{
+	bool hasStatements = false;
+	for( asCScriptNode *n = node->firstChild; n; n = n->next )
+		hasStatements |= n->nodeType == snTopLevelStatement;
+	if( !hasStatements )
+	{
+		node->Destroy(engine);
+		return 0;
+	}
+
+	for( asCScriptNode *n = node->firstChild; n; n = n->next )
+	{
+		if( n->nodeType != snGlobalInit ) continue;
+		sGlobalVariableDescription *gvar = GetTopLevelGlobal(file, n->tokenPos);
+		if( gvar )
+			gvar->initInPlace = true;
+	}
+
+	asCString name(AS_TOP_LEVEL_FUNCTION);
+	asCDataType returnType = asCDataType::CreatePrimitive(ttVoid, false);
+	asCArray<asCString> parameterNames;
+	asCArray<asCDataType> parameterTypes;
+	asCArray<asETypeModifiers> inOutFlags;
+	asCArray<asCString *> defaultArgs;
+	asSFunctionTraits funcTraits;
+	return RegisterScriptFunction(node, file, 0, false, true, ns, false, false, name, returnType, parameterNames,
+	                              parameterTypes, inOutFlags, defaultArgs, funcTraits, 0);
+}
