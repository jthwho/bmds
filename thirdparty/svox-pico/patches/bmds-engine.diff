+/**
+ * BMDS: pico_setEngineMarkup : Sets whether an engine obeys the markup tags in
+ * its text (it does when created) or reads them as text; from the next
+ * character put.
+ * @param    engine : pointer to a Pico engine handle
+ * @param    enabled : TRUE to obey tags
+ * @return  PICO_OK : successful
+ * @return     PICO_ERR_INVALID_HANDLE : errors
+*/
+PICO_FUNC pico_setEngineMarkup(
+        pico_Engine engine,
+        pico_Int16 enabled
+        )
+{
+    if (!picoctrl_isValidEngineHandle((picoctrl_Engine) engine)) {
+        return PICO_ERR_INVALID_HANDLE;
+    }
+    picoctrl_engGetCommon((picoctrl_Engine) engine)->markupOff = enabled ? FALSE : TRUE;
+    return PICO_OK;
+}
+
+/**
+ * BMDS: pico_setEngineProsody : Sets an engine's speed, pitch and volume, in
+ * percent of the voice's (as the markup's levels: speed 20 to 500, pitch 50
+ * to 200, volume 0 to 500), from the next character it reads. Markup in the
+ * text changes them after; its end tags go back to 100.
+ * @param    engine : pointer to a Pico engine handle
+ * @return  PICO_OK : successful
+ * @return     PICO_ERR_INVALID_HANDLE, PICO_ERR_INDEX_OUT_OF_RANGE : errors
+*/
+PICO_FUNC pico_setEngineProsody(
+        pico_Engine engine,
+        pico_Int16 speed,
+        pico_Int16 pitch,
+        pico_Int16 volume
+        )
+{
+    picoos_Common common;
+    if (!picoctrl_isValidEngineHandle((picoctrl_Engine) engine)) {
+        return PICO_ERR_INVALID_HANDLE;
+    }
+    if (speed < 20 || speed > 500 || pitch < 50 || pitch > 200 || volume < 0 || volume > 500) {
+        return PICO_ERR_INDEX_OUT_OF_RANGE;
+    }
+    common = picoctrl_engGetCommon((picoctrl_Engine) engine);
+    common->speed = (picoos_uint16) speed;
+    common->pitch = (picoos_uint16) pitch;
+    common->volume = (picoos_uint16) volume;
+    return PICO_OK;
+}
+
