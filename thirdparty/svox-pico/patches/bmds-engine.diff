+/* BMDS: puts a command for each of the engine's speed, pitch and volume
+ * (pico_setEngineProsody) that changed since last put; TRUE if any did */
+static picoos_bool tok_putProsody (picodata_ProcessingUnit this, tok_subobj_t * tok)
+{
+    picoos_bool put = FALSE;
+    if (tok->speed != this->common->speed) {
+        tok->speed = this->common->speed;
+        tok_putItem(this, tok, PICODATA_ITEM_CMD, PICODATA_ITEMINFO1_CMD_SPEED, PICODATA_ITEMINFO2_CMD_ABSOLUTE, tok->speed, (picoos_uchar*)"");
+        put = TRUE;
+    }
+    if (tok->pitch != this->common->pitch) {
+        tok->pitch = this->common->pitch;
+        tok_putItem(this, tok, PICODATA_ITEM_CMD, PICODATA_ITEMINFO1_CMD_PITCH, PICODATA_ITEMINFO2_CMD_ABSOLUTE, tok->pitch, (picoos_uchar*)"");
+        put = TRUE;
+    }
+    if (tok->volume != this->common->volume) {
+        tok->volume = this->common->volume;
+        tok_putItem(this, tok, PICODATA_ITEM_CMD, PICODATA_ITEMINFO1_CMD_VOLUME, PICODATA_ITEMINFO2_CMD_ABSOLUTE, tok->volume, (picoos_uchar*)"");
+        put = TRUE;
+    }
+    return put;
+}
