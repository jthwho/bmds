+/* BMDS: picorsrc_loadResource's twin for a resource file whose 'size' bytes
+ * lie at 'data' (a mapping of it, or a copy), used where it lies: nothing is
+ * copied, and nothing freed when it is unloaded. 'data' must stay valid and
+ * unchanged while the resource is loaded. Every length in the header is
+ * checked against 'size'. */
+pico_status_t picorsrc_loadResourceInPlace(picorsrc_ResourceManager this,
+        const picoos_uint8 * data, picoos_uint32 size, picorsrc_Resource * resource)
+{
+    picorsrc_Resource res;
+    picoos_file_header_t header;
+    picoos_char svox[32];
+    picoos_uint8 svoxLen;
+    picoos_uint32 pos, hdrlen, len;
+    pico_status_t status = PICO_OK;
+
+    if (resource == NULL || data == NULL) {
+        return PICO_ERR_NULLPTR_ACCESS;
+    }
+    *resource = NULL;
+
+    /* the SVOX header, after at most PICO_MAX_FOREIGN_HEADER_LEN other bytes */
+    if (PICO_OK != picoos_getSVOXHeaderString(svox, &svoxLen, sizeof(svox))) {
+        return PICO_ERR_OTHER;
+    }
+    for (pos = 0; pos <= PICO_MAX_FOREIGN_HEADER_LEN; pos++) {
+        if (pos + svoxLen > size) {
+            pos = PICO_MAX_FOREIGN_HEADER_LEN + 1;
+        } else if (0 == memcmp(data + pos, svox, svoxLen)) {
+            break;
+        }
+    }
+    if (pos > PICO_MAX_FOREIGN_HEADER_LEN) {
+        return picoos_emRaiseException(this->common->em, PICO_EXC_UNEXPECTED_FILE_TYPE, NULL,
+                                       (picoos_char *) "no SVOX header");
+    }
+    pos += svoxLen;
+
+    /* the header string: its length (16 bits), then it */
+    if (pos + 2 > size) {
+        return PICO_EXC_UNEXPECTED_FILE_TYPE;
+    }
+    hdrlen = (picoos_uint32) data[pos] | ((picoos_uint32) data[pos + 1] << 8);
+    pos += 2;
+    if (hdrlen > PICOOS_MAX_HEADER_STRING_LEN - 1 || pos + hdrlen > size) {
+        return PICO_EXC_UNEXPECTED_FILE_TYPE;
+    }
+    memcpy(this->tmpHeader, data + pos, hdrlen);
+    this->tmpHeader[hdrlen] = NULLC;
+    pos += hdrlen;
+    status = picoos_hdrParseHeader(&header, this->tmpHeader);
+    if (PICO_OK != status) {
+        return status;
+    }
+    if (isResourceLoaded(this, header.field[PICOOS_HEADER_NAME].value)) {
+        picoos_emRaiseWarning(this->common->em,PICO_WARN_RESOURCE_DOUBLE_LOAD,NULL,(picoos_char *)"%s",header.field[PICOOS_HEADER_NAME].value);
+        return PICO_OK;
+    }
+
+    /* the data's length (32 bits), then the data */
+    if (pos + 4 > size) {
+        return PICO_EXC_UNEXPECTED_FILE_TYPE;
+    }
+    len = (picoos_uint32) data[pos] | ((picoos_uint32) data[pos + 1] << 8)
+          | ((picoos_uint32) data[pos + 2] << 16) | ((picoos_uint32) data[pos + 3] << 24);
+    pos += 4;
+    if (len > size - pos) {
+        return PICO_EXC_UNEXPECTED_FILE_TYPE;
+    }
+
+    if (PICO_MAX_NUM_RESOURCES <= this->numResources) {
+        return picoos_emRaiseException(this->common->em,PICO_EXC_MAX_NUM_EXCEED,NULL,(picoos_char *)"no more than %i resources",PICO_MAX_NUM_RESOURCES);
+    }
+    res = picorsrc_newResource(this->common->mm);
+    if (NULL == res) {
+        return picoos_emRaiseException(this->common->em,PICO_EXC_OUT_OF_MEM,NULL,NULL);
+    }
+    /* read only, though Pico's types don't say so */
+    res->start = (picoos_uint8 *) (uintptr_t) (data + pos);
+    status = describeResource(this, res, &header, len);
+    if (status == PICO_OK) {
+        res->next = this->resources;
+        this->resources = res;
+        this->numResources++;
+        *resource = res;
+    } else {
+        picorsrc_disposeResource(this->common->mm, &res);
+    }
+    return (status < 0) ? status : PICO_OK;
+}
