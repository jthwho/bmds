+/**
+ * BMDS: pico_loadResourceInPlace : Loads a resource file whose bytes lie in
+ * memory, used where they lie (nothing copied)
+ * @param    system : pointer to a pico_System struct
+ * @param    data : the file's bytes: valid and unchanged while it is loaded
+ * @param    size : their number
+ * @param    *outLingware : pointer to receive the loaded lingware resource
+ * @return  PICO_OK : successful
+ * @return     PICO_ERR_INVALID_HANDLE, PICO_ERR_NULLPTR_ACCESS, PICO_EXC_UNEXPECTED_FILE_TYPE : errors
+*/
+PICO_FUNC pico_loadResourceInPlace(
+        pico_System system,
+        const void *data,
+        pico_Uint32 size,
+        pico_Resource *outLingware
+        )
+{
+    pico_Status status = PICO_OK;
+
+    if (!is_valid_system_handle(system)) {
+        status = PICO_ERR_INVALID_HANDLE;
+    } else if ((data == NULL) || (outLingware == NULL)) {
+        status = PICO_ERR_NULLPTR_ACCESS;
+    } else {
+        picoos_emReset(system->common->em);
+        status = picorsrc_loadResourceInPlace(system->rm, (const picoos_uint8 *) data, size,
+                                              (picorsrc_Resource *) outLingware);
+    }
+
+    return status;
+}
