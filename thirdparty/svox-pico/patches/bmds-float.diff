diff --git a/lib/picopal.c b/lib/picopal.c
index b3b6ae3..303ddb9 100644
--- a/lib/picopal.c
+++ b/lib/picopal.c
@@ -558,6 +558,29 @@ picopal_double picopal_quick_exp(const picopal_double y) {
 }
 
 
+/* BMDS: picopal_quick_exp in single precision, for an FPU without doubles
+ * (the ESP32-P4's: there the double one, called for every spectrum bin of
+ * every frame, was a tenth of the synthesis in software arithmetic). The
+ * same curve: 2^23/ln 2 in place of 2^20/ln 2, and 127*2^23 - 8*60801 for
+ * 1023*2^20 - 60801; the double one sets only its high word (20 bits of
+ * mantissa, the low word left uninitialized), this has 23. 'y' is held to
+ * a float's range of exponents, where the conversion to an integer is
+ * defined. */
+picopal_single picopal_quick_expf(const picopal_single y) {
+    union {
+        picopal_single f;
+        picopal_int32 i;
+    } _eco;
+    picopal_single x = y;
+    if (x > 88.0f) {
+        x = 88.0f;
+    } else if (x < -87.0f) {
+        x = -87.0f;
+    }
+    _eco.i = (picopal_int32)(12102203.161561485f * x) + 1064866808;
+    return _eco.f;
+}
+
