+/* BMDS: every index the loader follows checked first (found by fuzzing): each list ends with its
+   terminal record, and the bag and generator indices only grow and stay inside their lists. */
+static int tsf_hydra_check(const struct tsf_hydra *hydra)
+{
+	int i;
+	if (hydra->phdrNum < 1 || hydra->pbagNum < 1 || hydra->pgenNum < 1 || hydra->instNum < 1 || hydra->ibagNum < 1 || hydra->igenNum < 1 || hydra->shdrNum < 1) return 0;
+	for (i = 0; i < hydra->phdrNum; i++)
+		if (hydra->phdrs[i].presetBagNdx >= hydra->pbagNum || (i && hydra->phdrs[i].presetBagNdx < hydra->phdrs[i - 1].presetBagNdx)) return 0;
+	for (i = 0; i < hydra->pbagNum; i++)
+		if (hydra->pbags[i].genNdx > hydra->pgenNum || (i && hydra->pbags[i].genNdx < hydra->pbags[i - 1].genNdx)) return 0;
+	for (i = 0; i < hydra->instNum; i++)
+		if (hydra->insts[i].instBagNdx >= hydra->ibagNum || (i && hydra->insts[i].instBagNdx < hydra->insts[i - 1].instBagNdx)) return 0;
+	for (i = 0; i < hydra->ibagNum; i++)
+		if (hydra->ibags[i].instGenNdx > hydra->igenNum || (i && hydra->ibags[i].instGenNdx < hydra->ibags[i - 1].instGenNdx)) return 0;
+	return 1;
+}
