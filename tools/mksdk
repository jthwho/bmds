#
# Makes the SDK's release asset (devplan/thirdparty.md §6): bmds-sdk-VERSION.tar.gz, what a
# program outside this repository builds and packages with (bmds-apps does).
#
#   tools/mksdk VERSION OUT_DIR
#
# It holds, under bmds-sdk-VERSION/, the repository's own layout so every tool's paths hold:
#   sdk/            every file git tracks in sdk/, or would (as checked out: Git LFS files whole), and
#                   sdk/VERSION (VERSION)
#   tools/          mkpkg (packages, indexes, keys) and what it and bmds-fault need
#   keys/           dev.key and dev.pub (anyone may sign with the dev key), packages.pub,
#                   README.md (the kinds of key, and publishing your own)
#   LICENSE, README.md (where to start)
# Its files are in a fixed order with the commit's time and no owner, so the same tree makes the
# same bytes. Python's standard library only.

import gzip
import io
import os
import subprocess
import sys
import tarfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TOOLS = ["mkpkg", "bmdscontainer.py", "bmdself.py", "bmds-fault"]
KEYS = ["dev.key", "dev.pub", "packages.pub", "README.md"]

README = """# BMDS SDK {version}

Builds programs for BMDS on a PC and packages them for `pkg`. `sdk/README.md` is the SDK's
reference: building a program, the C library, C++, and publishing packages.

    cmake -S myprog -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=$PWD/sdk/cmake/bmds-toolchain.cmake

The compiler is Espressif's riscv32-esp-elf-gcc (sdk/TOOLCHAIN says which, and where to get it).
tools/mkpkg makes packages, indexes and signing keys; keys/README.md says which key is which.
bmds-apps (https://github.com/jthwho/bmds-apps) is a complete example of a repository of
packages built with this SDK.
"""


def fail(message):
    sys.exit("mksdk: " + message)


def tracked(path):
    """The files git tracks under @p path, and new ones it doesn't ignore (a --dev release from
    a tree not yet committed), sorted."""
    out = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", path], cwd=ROOT, capture_output=True, check=True).stdout
    return sorted(p for p in out.decode().split("\0") if p)


def lfs_pointer(path):
    with open(path, "rb") as f:
        return f.read(64).startswith(b"version https://git-lfs.github.com/spec/")


def main():
    if len(sys.argv) != 3:
        fail("usage: tools/mksdk VERSION OUT_DIR")
    version, out_dir = sys.argv[1], sys.argv[2]
    if not version or "/" in version:
        fail("a version like 0.2.0")
    when = int(subprocess.run(["git", "log", "-1", "--format=%ct"], cwd=ROOT, capture_output=True, text=True,
                              check=True).stdout.strip() or 0)
    top = "bmds-sdk-%s" % version
    files = tracked("sdk") + ["tools/" + t for t in TOOLS] + ["keys/" + k for k in KEYS] + ["LICENSE"]
    generated = {"sdk/VERSION": version + "\n", "README.md": README.format(version=version)}

    def info(name, size, mode):
        t = tarfile.TarInfo("%s/%s" % (top, name))
        t.size, t.mode, t.mtime = size, mode, when
        t.uid = t.gid = 0
        t.uname = t.gname = ""
        return t

    os.makedirs(out_dir, exist_ok=True)
    out = os.path.join(out_dir, top + ".tar.gz")
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for name in sorted(set(files) | set(generated)):
            if name in generated:
                data = generated[name].encode()
                tar.addfile(info(name, len(data), 0o644), io.BytesIO(data))
                continue
            path = os.path.join(ROOT, name)
            if not os.path.isfile(path):
                fail("%s isn't there" % name)
            if lfs_pointer(path):
                fail("%s is a Git LFS pointer: git lfs pull first" % name)
            mode = 0o755 if os.access(path, os.X_OK) else 0o644
            with open(path, "rb") as f:
                tar.addfile(info(name, os.path.getsize(path), mode), f)
    # gzip without a name or time in its header: the same bytes for the same tree.
    with open(out, "wb") as f, gzip.GzipFile(filename="", mode="wb", fileobj=f, mtime=0, compresslevel=9) as gz:
        gz.write(raw.getvalue())
    print("%s: %d files, %d bytes" % (out, len(set(files) | set(generated)), os.path.getsize(out)))


if __name__ == "__main__":
    main()
