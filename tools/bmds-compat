#
# Runs the compatibility corpus on a board (docs/ABI.md): programs built with
# an older SDK, kept as built, must still do exactly what they did. Sends a
# corpus directory's programs to the card (FAT, as they were written
# against: v1's posix case expects names to fold case) and runs each case of
# its cases.txt there, comparing output (stdout and stderr together, as the
# console shows them) and exit status. Exits 1 if any case differs.
#
# cases.txt: "# comments", then per case a line "=== command" (shell syntax,
# run in the corpus directory on the board), the expected output lines, and
# "--- status".

import argparse
import difflib
import glob
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bmdsboard  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def parse(path):
    cases, current = [], None
    with open(path, encoding="utf-8") as f:
        for number, line in enumerate(f, 1):
            line = line.rstrip("\n")
            if current is None:
                if line.startswith("=== "):
                    current = {"line": number, "command": line[4:], "output": []}
                elif line and not line.startswith("#"):
                    sys.exit("%s:%d: expected '=== command'" % (path, number))
            elif line.startswith("--- "):
                current["status"] = int(line[4:])
                cases.append(current)
                current = None
            else:
                current["output"].append(line + "\n")
    if current is not None:
        sys.exit("%s: the last case has no '--- status'" % path)
    return cases


def main():
    parser = argparse.ArgumentParser(description="Run the compatibility corpus on a BMDS board.")
    parser.add_argument("-p", "--port", help="serial port (default: $ESPPORT, /dev/esp-*, /dev/ttyACM0)")
    parser.add_argument("-u", "--update", action="store_true",
                        help="print the cases with the board's results instead (for writing new cases)")
    parser.add_argument("corpus", nargs="*", help="corpus directories (default: every tests/compat/v*)")
    opts = parser.parse_args()
    corpora = opts.corpus or sorted(glob.glob(os.path.join(ROOT, "tests", "compat", "v*")))
    failed = 0
    try:
        board = bmdsboard.Board(opts.port)
        board.sync()
        for corpus in corpora:
            name = os.path.basename(os.path.normpath(corpus))
            where = "/sd0/p0/compat"
            board.send_files(sorted(glob.glob(os.path.join(corpus, "*.elf"))), where)
            for case in parse(os.path.join(corpus, "cases.txt")):
                output, status = board.run("(cd %s && %s)" % (where, case["command"]), 30)
                got = output.decode(errors="replace").splitlines(keepends=True)
                if got and not got[-1].endswith("\n"):
                    got[-1] += "\n"
                if opts.update:
                    print("=== %s\n%s--- %d\n" % (case["command"], "".join(got), status))
                    continue
                if got == case["output"] and status == case["status"]:
                    print("ok    %s: %s" % (name, case["command"]))
                    continue
                failed += 1
                print("FAIL  %s: %s (cases.txt:%d)" % (name, case["command"], case["line"]))
                if status != case["status"]:
                    print("      status %d, expected %d" % (status, case["status"]))
                for d in difflib.unified_diff(case["output"], got, "expected", "got"):
                    print("      " + d, end="")
            board.run("rm -r %s" % where)
    except bmdsboard.BoardError as e:
        print("bmds-compat: %s" % e, file=sys.stderr)
        return 2
    if not opts.update:
        print("%d failed" % failed if failed else "all passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
