def main():
        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, "rom", "patterns")
        os.makedirs(out, exist_ok=True)
        made = set()
        for p in PATTERNS:
                path = p.save(out)
                made.add(os.path.basename(path))
                print("%s: %dx%d, %d bytes" % (path, p.width, p.height, os.path.getsize(path)))
        for name in os.listdir(out):
                if name.endswith(".png") and name not in made:
                        os.remove(os.path.join(out, name))
                        print("removed " + name)


if __name__ == "__main__":
        main()
