# Push-and-run: sends a program to the board's RAM disk with YMODEM and runs
# it there, with its output here, and exits with its status. No reflash and
# no card needed. Keys typed on a terminal go to the program (Ctrl-C too);
# Ctrl-] stops it and leaves. Needs pyserial (run inside ESP-IDF's
# environment, or pip install pyserial).

import argparse
import os
import sys
import termios
import tty

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bmdsboard  # noqa: E402


def main():
    parser = argparse.ArgumentParser(
        description="Send a program to a BMDS board and run it there.",
        epilog="The exit status is the program's (255 if the board couldn't be reached).",
    )
    parser.add_argument("-p", "--port", help="serial port (default: $ESPPORT, /dev/esp-*, /dev/ttyACM0)")
    parser.add_argument("-d", "--dir", default="/ram0/p0", help="directory on the board (default: /ram0/p0)")
    parser.add_argument("-n", "--no-run", action="store_true", help="only send the files")
    parser.add_argument("-f", "--file", action="append", default=[], metavar="FILE",
                        help="send another file along (data, scripts); repeatable")
    parser.add_argument("-t", "--timeout", type=float, help="stop the program after this many seconds")
    parser.add_argument("program", help="the program (.elf) or script to send and run")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="its arguments")
    opts = parser.parse_args()

    try:
        board = bmdsboard.Board(opts.port)
        board.sync()
        board.send_files(opts.file + [opts.program], opts.dir)
    except bmdsboard.BoardError as e:
        print("bmds-run: %s" % e, file=sys.stderr)
        return 255
    if opts.no_run:
        return 0

    path = opts.dir.rstrip("/") + "/" + os.path.basename(opts.program)
    line = " ".join(bmdsboard.quote(w) for w in [path] + opts.args)
    keys = sys.stdin.fileno() if sys.stdin.isatty() else None
    saved = termios.tcgetattr(keys) if keys is not None else None
    try:
        if keys is not None:
            tty.setraw(keys)
        board.start(line)
        return board.read_output(bmdsboard.stdout_sink(), opts.timeout, keys)
    except bmdsboard.BoardError as e:
        print("\r\nbmds-run: %s" % e, file=sys.stderr)
        return 124 if str(e) == "timed out" else 255
    except KeyboardInterrupt:
        return 130
    finally:
        if saved is not None:
            termios.tcsetattr(keys, termios.TCSADRAIN, saved)
        board.close()


if __name__ == "__main__":
    sys.exit(main())
