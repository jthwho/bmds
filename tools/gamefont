# Makes sdk/game/font16.c, libbmdsgame's text glyphs (devplan/games.md §13): unscii-16's 8x16
# glyphs for ASCII (0x20-0x7E) and Latin-1 (0xA0-0xFF), from thirdparty/unscii/unscii-16.hex.
#
#   tools/gamefont > sdk/game/font16.c

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HEX = os.path.join(ROOT, "thirdparty", "unscii", "unscii-16.hex")
RANGES = [(0x20, 0x7E), (0xA0, 0xFF)]


def main():
    glyphs = {}
    with open(HEX) as f:
        for line in f:
            code, _, bits = line.strip().partition(":")
            if code and len(bits) == 32:
                glyphs[int(code, 16)] = bytes.fromhex(bits)
    out = ["/**",
           " * @file      font16.c",
           " * @copyright Jason Howard. All rights reserved.",
           " *",
           " * SPDX-License-Identifier: MIT",
           " * See LICENSE file in the project root folder for license information.",
           " *",
           " * Generated by tools/gamefont from thirdparty/unscii/unscii-16.hex (unscii: public domain):",
           " * 8x16 glyphs, a byte a row, the leftmost pixel the top bit; ASCII 0x20-0x7E, then",
           " * Latin-1 0xA0-0xFF. Don't edit.",
           " */",
           "",
           "#include \"game_internal.h\"",
           "",
           "const unsigned char bmds_game_font16[BMDS_GAME_FONT_GLYPHS][16] = {"]
    count = 0
    for first, last in RANGES:
        for cp in range(first, last + 1):
            g = glyphs.get(cp, bytes(16))
            out.append("        {" + ", ".join("0x%02x" % b for b in g) + "}, /* U+%04X */" % cp)
            count += 1
    out.append("};")
    sys.stdout.write("\n".join(out) + "\n")
    if count != 191:
        sys.exit("gamefont: %d glyphs" % count)


if __name__ == "__main__":
    main()
