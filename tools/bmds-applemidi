# A small AppleMIDI peer (RTP-MIDI's session protocol, devplan/audio.md §23) for trying the
# board's network MIDI from a PC without rtpmidid: Python's standard library only.
#
#   bmds-applemidi invite HOST [PORT]   start a session with HOST (the board: 5004), send notes,
#                                       print what comes back, end it
#   bmds-applemidi listen [PORT]        take the board's invitation ('midi net connect PC:PORT'),
#                                       print what comes, answer clock syncs; Ctrl+C ends it
#
# Options: --name NAME (the session's name), --notes N (notes sent after the session is up, 0.2 s
# apart; invite only), --wait S (seconds to keep listening after them), --sysex (a SysEx too).

import argparse
import os
import random
import select
import socket
import struct
import sys
import time


def now_units():
    return int(time.monotonic() * 10000)  # AppleMIDI's 100 us units


def session(cmd, token, ssrc, name=None):
    b = b"\xff\xff" + cmd + struct.pack(">III", 2, token, ssrc)
    if name is not None:
        b += name.encode() + b"\0"
    return b


def sync(ssrc, count, t):
    return b"\xff\xffCK" + struct.pack(">IB3xQQQ", ssrc, count, t[0], t[1], t[2])


def rtp(seq, ssrc, commands):
    # The command list's long header: no journal, no first delta.
    header = struct.pack(">BBHII", 0x80, 0x61, seq & 0xFFFF, now_units() & 0xFFFFFFFF, ssrc)
    return header + struct.pack(">H", 0x8000 | len(commands)) + commands


def midi_of(packet):
    """The command list's bytes, delta times dropped (good enough for showing)."""
    if len(packet) < 13:
        return None
    at = 12 + 4 * (packet[0] & 0x0F)
    h = packet[at]
    at += 1
    length = h & 0x0F
    if h & 0x80:
        length = (length << 8) | packet[at]
        at += 1
    cmds = packet[at:at + length]
    out, i, first = [], 0, not (h & 0x20)
    while i < len(cmds):
        if not first:
            while i < len(cmds) and cmds[i] & 0x80:
                i += 1
            i += 1
        first = False
        if i >= len(cmds):
            break
        b = cmds[i]
        if b in (0xF0, 0xF7):
            j = i + 1
            while j < len(cmds) and cmds[j] not in (0xF0, 0xF7, 0xF4):
                j += 1
            out.append(cmds[i:j + 1])
            i = j + 1
            continue
        n = 1
        if b & 0x80:
            s = b
            n = {0xC0: 2, 0xD0: 2}.get(s & 0xF0, 3) if s < 0xF0 else {0xF1: 2, 0xF3: 2, 0xF2: 3}.get(s, 1)
        else:
            n = 2
        out.append(cmds[i:i + n])
        i += n
    return out, (h & 0x40) != 0


class Peer:
    def __init__(self, name, control_port):
        self.name = name
        self.ssrc = random.getrandbits(32)
        self.control = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.data = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.control.bind(("0.0.0.0", control_port))
        self.data.bind(("0.0.0.0", self.control.getsockname()[1] + 1))
        self.seq = random.getrandbits(16)
        self.remote_data = None
        self.remote_control = None
        self.remote_ssrc = None

    def wait(self, timeout, want=None):
        """Handles what arrives for TIMEOUT seconds; returns the first session packet WANT."""
        end = time.monotonic() + timeout
        while True:
            left = end - time.monotonic()
            if left <= 0:
                return None
            ready, _, _ = select.select([self.control, self.data], [], [], left)
            for s in ready:
                packet, sender = s.recvfrom(2048)
                channel = "control" if s is self.control else "data"
                got = self.handle(channel, packet, sender)
                if want is not None and got is not None and got[0] in (want if isinstance(want, tuple) else (want,)):
                    return got

    def handle(self, channel, packet, sender):
        if packet[:2] == b"\xff\xff":
            cmd = packet[2:4]
            if cmd in (b"IN", b"OK", b"NO", b"BY"):
                _, token, ssrc = struct.unpack(">III", packet[4:16])
                name = packet[16:].split(b"\0")[0].decode(errors="replace")
                print(f"  {channel}: {cmd.decode()} from {sender[0]}:{sender[1]} ({name or '-'})")
                if cmd == b"IN":
                    sock = self.control if channel == "control" else self.data
                    sock.sendto(session(b"OK", token, self.ssrc, self.name), sender)
                    self.remote_ssrc = ssrc
                    if channel == "control":
                        self.remote_control = sender
                    else:
                        self.remote_data = sender
                return (cmd, channel, token, ssrc, name, sender)
            if cmd == b"CK":
                ssrc, count = struct.unpack(">IB", packet[4:9])
                t = list(struct.unpack(">QQQ", packet[12:36]))
                if count == 0:
                    t[1] = now_units()
                    self.data.sendto(sync(self.ssrc, 1, t), sender)
                elif count == 1:
                    t[2] = now_units()
                    self.data.sendto(sync(self.ssrc, 2, t), sender)
                    print(f"  sync: round trip {(t[2] - t[0]) * 100} us")
                return (b"CK", channel, count)
            if cmd == b"RS":
                return (b"RS", channel)
            return None
        got = midi_of(packet)
        if got is not None:
            commands, journal = got
            seq = struct.unpack(">H", packet[2:4])[0]
            text = "  ".join(c.hex(" ") for c in commands)
            print(f"  MIDI #{seq}: {text}{'  (journal)' if journal else ''}")
        return None

    def send_midi(self, commands):
        self.data.sendto(rtp(self.seq, self.ssrc, commands), self.remote_data)
        self.seq += 1

    def bye(self):
        if self.remote_control is not None:
            self.control.sendto(session(b"BY", 0, self.ssrc), self.remote_control)


def invite(args):
    peer = Peer(args.name, 0)
    host = socket.gethostbyname(args.host)
    token = random.getrandbits(32)
    print(f"Inviting {host}:{args.port} from UDP {peer.control.getsockname()[1]} as \"{args.name}\"")
    peer.control.sendto(session(b"IN", token, peer.ssrc, args.name), (host, args.port))
    got = peer.wait(3, (b"OK", b"NO"))
    if got is None or got[0] != b"OK":
        sys.exit("no answer" if got is None else "refused")
    peer.remote_control = (host, args.port)
    peer.data.sendto(session(b"IN", token, peer.ssrc, args.name), (host, args.port + 1))
    got = peer.wait(3, b"OK")
    if got is None:
        sys.exit("the data port didn't answer")
    peer.remote_data = (host, args.port + 1)
    print(f"Session up with \"{got[4]}\"")
    for _ in range(3):
        peer.data.sendto(sync(peer.ssrc, 0, [now_units(), 0, 0]), peer.remote_data)
        peer.wait(0.3)
    for i in range(args.notes):
        note = 60 + (i % 12)
        peer.send_midi(bytes([0x90, note, 100]))
        peer.wait(0.15)
        peer.send_midi(bytes([0x80, note, 0]))
        peer.wait(0.05)
    if args.sysex:
        peer.send_midi(bytes([0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7]))
    peer.wait(args.wait)
    peer.bye()
    print("Ended")


def listen(args):
    peer = Peer(args.name, args.port)
    print(f"Listening on UDP {args.port} and {args.port + 1} as \"{args.name}\"; Ctrl+C ends")
    try:
        while True:
            peer.wait(3600)
    except KeyboardInterrupt:
        peer.bye()


def main():
    p = argparse.ArgumentParser(description="A small AppleMIDI peer for trying network MIDI")
    p.add_argument("--name", default=f"{socket.gethostname()} test")
    sub = p.add_subparsers(dest="what", required=True)
    i = sub.add_parser("invite")
    i.add_argument("host")
    i.add_argument("port", nargs="?", type=int, default=5004)
    i.add_argument("--notes", type=int, default=8)
    i.add_argument("--wait", type=float, default=2.0)
    i.add_argument("--sysex", action="store_true")
    l = sub.add_parser("listen")
    l.add_argument("port", nargs="?", type=int, default=5008)
    args = p.parse_args()
    invite(args) if args.what == "invite" else listen(args)


if __name__ == "__main__":
    main()
