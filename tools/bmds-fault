#
# Names the stack traces of program faults in a system log (devplan/protection.md §21). A program
# that faults is reported in three parts: the fault ("PATH[PID]: Segmentation fault at +0x1234,
# called from +0x1200, ..."), its trace ("  PID: trace +0x1234 +0x1200 ...": the PC, then what
# looks like a return address on its stack) and its registers. Addresses written "+0x..." are
# offsets in the program's image, which are its ELF's addresses: this resolves them with
# addr2line (functions; files and lines too for a program built with -g) against the program's
# unstripped ELF, found as bmds-prof finds it (the firmware's ROM build, the distribution's, the
# SDK examples) or given with --program NAME=ELF.
#
#   ssh root@bmds0 'log show' | tools/bmds-fault
#   tools/bmds-fault [--program NAME=ELF]... [--all] [LOG...]
#
# Programs keep no frame pointer, so the trace is a scan of the stack: a return address left there
# by a call that has since returned can show up too (Linux marks such entries "?"; a log can't
# tell them apart). Only the last fault is decoded unless --all. Python's standard library only; needs riscv32-esp-elf-addr2line (on PATH after
# ESP-IDF's export.sh, or under ~/.espressif).

import argparse
import glob
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAULT = re.compile(r"\bE (\S+)\[(\d+(?:/\d+)?)\]: (.+? at \S+, called from .*)$")
TRACE = re.compile(r"\bE   (\d+(?:/\d+)?): trace((?: \S+)+)\s*$")
REGS = re.compile(r"\bE   (\d+(?:/\d+)?):((?: \w+ [0-9a-f]{8})+)\s*$")


def addr2line():
    tool = shutil.which("riscv32-esp-elf-addr2line")
    if tool:
        return tool
    found = sorted(glob.glob(os.path.expanduser(
        "~/.espressif/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-addr2line")))
    if not found:
        sys.exit("bmds-fault: riscv32-esp-elf-addr2line not found (run ESP-IDF's export.sh)")
    return found[-1]


def find_program(name):
    """The unstripped ELF of a program the board ran as NAME (a link's target followed)."""
    for dist in ("build/rom/dist", "build-dist"):
        for link in glob.glob(os.path.join(ROOT, dist, "stage", "*", "bin", name)):
            target = os.path.basename(os.path.realpath(link))
            package = link.split(os.sep)[-3]
            for top, _, files in os.walk(os.path.join(ROOT, dist, "build", package)):
                if target in files:
                    return os.path.join(top, target)
    stem = name[:-4] if name.endswith(".elf") else name
    for candidate in (stem + ".debug.elf", stem + ".elf"):
        example = os.path.join(ROOT, "build-host", "sdk-examples", candidate)
        if os.path.exists(example):
            return example
    return None


def resolve(elf, offsets):
    """Each offset as "function at file:line" (inlined callers after it)."""
    if not offsets:
        return {}
    out = subprocess.run([addr2line(), "-f", "-C", "-i", "-p", "-e", elf] + ["%x" % o for o in offsets],
                         capture_output=True, text=True, check=True).stdout
    # One address per block: -i adds " (inlined by) ..." lines after the first.
    blocks, current = [], []
    for line in out.splitlines():
        if line.startswith(" (inlined by)") and current:
            current.append(line.strip())
        else:
            if current:
                blocks.append(current)
            current = [line.strip()]
    if current:
        blocks.append(current)
    return dict(zip(offsets, blocks))


# The log's source tag at a line's end ("(faults.cpp:249)").
SOURCE = re.compile(r"\s+\([\w./-]+:\d+\)\s*$")


def faults(lines):
    """Each fault: its header, its trace's addresses, its register lines."""
    found = []
    for line in lines:
        line = SOURCE.sub("", line.rstrip("\n"))
        m = FAULT.search(line)
        if m:
            found.append({"path": m.group(1), "who": m.group(2), "what": m.group(3), "trace": [], "regs": []})
            continue
        if not found:
            continue
        m = TRACE.search(line)
        if m and m.group(1) == found[-1]["who"]:
            found[-1]["trace"] += m.group(2).split()
            continue
        m = REGS.search(line)
        if m and m.group(1) == found[-1]["who"]:
            found[-1]["regs"].append(m.group(2).strip())
    return found


def main():
    parser = argparse.ArgumentParser(description="Name the stack traces of program faults in a log.")
    parser.add_argument("logs", nargs="*", help="system logs, oldest first (none: standard input)")
    parser.add_argument("--program", action="append", default=[], metavar="NAME=ELF",
                        help="the unstripped ELF for the program file NAME")
    parser.add_argument("--all", action="store_true", help="every fault, not only the last")
    args = parser.parse_args()

    given = dict(p.split("=", 1) for p in args.program)
    lines = []
    if args.logs:
        for name in args.logs:
            with open(name, errors="replace") as f:
                lines += f.readlines()
    else:
        lines = sys.stdin.read().splitlines()
    found = faults(lines)
    if not found:
        sys.exit("bmds-fault: no program fault in the log")
    for fault in (found if args.all else found[-1:]):
        name = os.path.basename(fault["path"])
        elf = given.get(name) or find_program(name)
        print("%s[%s]: %s" % (fault["path"], fault["who"], fault["what"]))
        offsets = [int(a[1:], 16) for a in fault["trace"] if a.startswith("+0x")]
        names = resolve(elf, offsets) if elf else {}
        if elf is None:
            print("  (no ELF for %s: give --program %s=ELF)" % (name, name))
        for i, a in enumerate(fault["trace"]):
            where = names.get(int(a[1:], 16)) if a.startswith("+0x") else None
            text = "  ".join(where) if where else ("outside the image" if not a.startswith("+0x") else "?")
            print("  #%-2d %-10s %s" % (i, a, text))
        for row in fault["regs"]:
            print("     " + row)
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
