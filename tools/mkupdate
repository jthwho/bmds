# Makes and reads update packages (.bmup, devplan/update.md §2; the format is
# components/bmds_core/include/bmds/updatepackage.h's).
#
#   mkupdate keygen KEY PUB [--comment TEXT]
#       A new signing key: the private key to KEY (PEM, mode 600; keep it out of the
#       repository), its public half to PUB (one line: "ed25519 HEX COMMENT").
#   mkupdate make OUT --board BOARD [--key KEY] [--firmware BIN] [--rom BIN]
#                 [--recovery BIN] [--notes FILE] [--abi N] [--partitions CSV] [--accept PUB]...
#       (--key defaults to keys/dev.key; --abi to sdk/include/bmds/sys.h's BMDS_ABI_VERSION)
#       A package of the images given, signed with KEY. With --accept, refused unless KEY is
#       one of those (the keys the firmware it is for accepts). The version, build id and least
#       chip revision come from the firmware's image (the recovery's if there is none).
#       With --partitions, each image is checked against its partition's size.
#   mkupdate info FILE [--pub PUB]...
#       Shows a package and checks its sections' hashes and its signature: against the
#       keys in PUB, or keys/dev.pub and keys/trusted.pub (keys/README.md). Exits 1 if anything doesn't check.

import argparse
import hashlib
import os
import struct
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bmdscontainer as bc  # noqa: E402

MAGIC = b'BMUP'
FORMAT = 1
HEADER_BYTES = 144
BODY = '<IHH32s32s32sqHHHH'  # the header after the container's prefix

FIRMWARE, ROM, RECOVERY, NOTES = 1, 2, 3, 4
NAMES = {FIRMWARE: 'firmware', ROM: 'rom', RECOVERY: 'recovery', NOTES: 'notes'}
PARTITIONS = {FIRMWARE: 'ota_0', ROM: 'rom', RECOVERY: 'ota_1'}

APP_MAGIC = 0xE9
APP_DESC_OFFSET = 32  # the image header (24) and the first segment's (8)
APP_DESC_MAGIC = 0xABCD5432

ROOT = bc.ROOT
KEYS = bc.KEYS


def abi_version():
    # The SDK's BMDS_ABI_VERSION, from this repository.
    sys_h = os.path.join(ROOT, 'sdk', 'include', 'bmds', 'sys.h')
    for line in open(sys_h):
        parts = line.split()
        if len(parts) >= 3 and parts[0] == '#define' and parts[1] == 'BMDS_ABI_VERSION':
            return int(parts[2].rstrip('uU'), 0)
    fail('no BMDS_ABI_VERSION in ' + sys_h)


def bmds_version():
    """bmds/version.h's (major, minor, patch): what a package's version is compared by."""
    path = os.path.join(ROOT, 'components', 'bmds_core', 'include', 'bmds', 'version.h')
    found = {}
    for line in open(path):
        parts = line.split()
        if len(parts) >= 3 and parts[0] == '#define' and parts[1].startswith('BMDS_VERSION_'):
            found[parts[1][len('BMDS_VERSION_'):]] = int(parts[2])
    try:
        return found['MAJOR'], found['MINOR'], found['PATCH']
    except KeyError:
        fail('no BMDS_VERSION_MAJOR, _MINOR and _PATCH in ' + path)


def fail(msg):
    sys.exit('mkupdate: ' + msg)


def field(text, what):
    try:
        return bc.text_field(text, 32, what)
    except bc.ContainerError as e:
        fail(str(e))


def app_info(image, what):
    """The version, build id and least chip revision of an IDF app image."""
    if len(image) < APP_DESC_OFFSET + 176 or image[0] != APP_MAGIC:
        fail('%s is not an app image' % what)
    min_rev = struct.unpack_from('<H', image, 15)[0]
    magic, = struct.unpack_from('<I', image, APP_DESC_OFFSET)
    if magic != APP_DESC_MAGIC:
        fail('%s has no app description' % what)
    version = image[APP_DESC_OFFSET + 16:APP_DESC_OFFSET + 48].split(b'\0')[0].decode('ascii', 'replace')
    elf_sha = image[APP_DESC_OFFSET + 144:APP_DESC_OFFSET + 176]
    if image[23] == 1:  # hash_appended: the last 32 bytes are SHA-256 of the rest
        if hashlib.sha256(image[:-32]).digest() != image[-32:]:
            fail('%s fails its own SHA-256' % what)
    return version, elf_sha, min_rev


def partition_sizes(csv):
    sizes = {}
    for line in open(csv):
        line = line.split('#')[0].strip()
        if not line:
            continue
        cols = [c.strip() for c in line.split(',')]
        if len(cols) >= 5:
            size = cols[4].upper()
            mult = 1
            if size.endswith('K'):
                mult, size = 1024, size[:-1]
            elif size.endswith('M'):
                mult, size = 1024 * 1024, size[:-1]
            sizes[cols[0]] = int(size, 0) * mult
    return sizes


def load_key(path):
    try:
        return bc.load_key(path)
    except bc.ContainerError as e:
        fail(str(e))


def cmd_keygen(args):
    try:
        bc.keygen(args.key, args.pub, args.comment)
    except bc.ContainerError as e:
        fail(str(e))
    print('private key: %s (keep it safe, out of the repository)' % args.key)
    print('public key:  %s' % args.pub)


def cmd_make(args):
    if args.key is None:
        args.key = os.path.join(KEYS, 'dev.key')
        print('signing with the dev key (only dev firmware accepts it)')
    key = load_key(args.key)
    if args.accept:
        mine = bc.public_bytes(key)
        if not any(k == mine for k, _ in bc.load_pubs(args.accept)):
            fail('%s is not a key %s accepts (keys/README.md)' % (args.key, ' or '.join(args.accept)))
    if args.abi is None:
        args.abi = abi_version()
    images = []
    for kind, path in ((FIRMWARE, args.firmware), (ROM, args.rom), (RECOVERY, args.recovery), (NOTES, args.notes)):
        if path:
            with open(path, 'rb') as f:
                images.append((kind, f.read()))
    if not any(kind in (FIRMWARE, ROM, RECOVERY) for kind, _ in images):
        fail('nothing to update: give --firmware, --rom or --recovery')
    info = None
    for kind, data in images:
        if kind in (FIRMWARE, RECOVERY):
            got = app_info(data, NAMES[kind])
            if info is None or kind == FIRMWARE:
                info = got
        elif kind == ROM and data[:4] != b'BMRO':
            fail('the ROM image has no BMRO header')
        elif kind == NOTES:
            data.decode('utf-8')  # must be text
    version, build_id, min_rev = info if info else ('', bytes(32), 0)
    number = bmds_version()
    dotted = '%d.%d.%d' % number
    if not version:
        version = dotted
    elif version.split('+')[0] != dotted:
        fail('the firmware says it is %s, bmds/version.h %s: a stale image?' % (version, dotted))
    if args.partitions:
        sizes = partition_sizes(args.partitions)
        for kind, data in images:
            part = PARTITIONS.get(kind)
            if part and len(data) > sizes.get(part, 0):
                fail('%s (%d bytes) is bigger than %s (%d)' % (NAMES[kind], len(data), part, sizes.get(part, 0)))

    body = struct.pack(BODY, args.abi, min_rev, 0, field(args.board, 'the board'), field(version, 'the version'),
                       build_id, int(time.time()), *number, 0)
    assert bc.PREFIX_BYTES + len(body) == HEADER_BYTES
    with open(args.out, 'wb') as f:
        f.write(bc.build(MAGIC, FORMAT, body, images, key))
    print('%s: %s for %s, %s' % (args.out, version or '(no firmware)', args.board,
                                 ', '.join('%s %d bytes' % (NAMES[k], len(d)) for k, d in images)))


def cmd_info(args):
    with open(args.file, 'rb') as f:
        data = f.read()
    try:
        c = bc.Container(data, MAGIC, FORMAT, HEADER_BYTES, 'an update package')
    except bc.ContainerError as e:
        fail('%s: %s' % (args.file, e))
    (abi, min_rev, _, board, version, build_id, made, major, minor, patch, _) = struct.unpack(BODY, c.body)
    print('board:    %s' % board.rstrip(b'\0').decode())
    print('version:  %d.%d.%d (%s)' % (major, minor, patch, version.rstrip(b'\0').decode()))
    print('build id: %s' % build_id.hex())
    print('made:     %s' % time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime(made)))
    print('abi:      %d; least chip revision v%d.%d' % (abi, min_rev // 100, min_rev % 100))
    for kind, offset, size, ok in c.sections:
        print('%-9s %9d bytes at %9d: %s' % (NAMES.get(kind, 'type %d' % kind) + ':', size, offset,
                                             'hash good' if ok else 'HASH BAD'))
    signer = c.signer(bc.load_pubs(args.pub or bc.default_pubs()))
    print('signed:   %s' % ('by ' + signer if signer else 'BY NONE OF THE KEYS (key id %s)' % c.key_id.hex()))
    sys.exit(0 if c.hashes_good() and signer is not None else 1)


def main():
    p = argparse.ArgumentParser(description='Makes and reads BMDS update packages (.bmup).')
    sub = p.add_subparsers(dest='cmd', required=True)
    k = sub.add_parser('keygen')
    k.add_argument('key')
    k.add_argument('pub')
    k.add_argument('--comment', default='bmds-update')
    m = sub.add_parser('make')
    m.add_argument('out')
    m.add_argument('--key', help='the signing key (default: keys/dev.key)')
    m.add_argument('--board', required=True)
    m.add_argument('--firmware')
    m.add_argument('--rom')
    m.add_argument('--recovery')
    m.add_argument('--notes')
    m.add_argument('--abi', type=int, help="BMDS_ABI_VERSION (default: the SDK's)")
    m.add_argument('--partitions')
    m.add_argument('--accept', action='append', help='a .pub file the key must be in')
    i = sub.add_parser('info')
    i.add_argument('file')
    i.add_argument('--pub', action='append')
    args = p.parse_args()
    {'keygen': cmd_keygen, 'make': cmd_make, 'info': cmd_info}[args.cmd](args)


if __name__ == '__main__':
    main()
