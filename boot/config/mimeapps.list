# /boot/config/mimeapps.list: which applications open files, by type, unless
# /home/.config/mimeapps.list exists
# (devplan/filetypes.md; freedesktop.org's format, read by the panel).
#
# TYPE=ID.desktop;ID2.desktop: the first ID found in the launcher's
# directories (sysconf's panel/launcher/applications) opens it. A type is a
# MIME type, as file_type() tells it; MEDIA/* matches a whole media type.
# A type with no line of its own tries MEDIA/*, then text/plain if it is
# text-like (scripts, JSON, empty files), then application/octet-stream.

[Default Applications]
text/*=vi.desktop
text/plain=vi.desktop
application/x-executable=run.desktop
audio/*=play.desktop
