menu "BMDS console"

    config BMDS_USJ_TX_BYTES
        int "USB-Serial/JTAG console output buffer (bytes, power of two)"
        default 1024
        range 128 65536
        help
            Output ring buffer of the USB-Serial/JTAG console, in PSRAM.
            The host drains about 64 bytes per millisecond while the serial
            port is open. Must be a power of two.

    config BMDS_USJ_RX_BYTES
        int "USB-Serial/JTAG console input buffer (bytes, power of two)"
        default 4096
        range 64 65536
        help
            Input ring buffer of the USB-Serial/JTAG console, in PSRAM. It
            holds input that arrives while a command runs (e.g. a paste, or
            a YMODEM block while rz writes to the card); there is no flow
            control, so input beyond it is dropped. Must be a power of two.

    choice BMDS_USJ_COLOR_DEPTH
        prompt "USB-Serial/JTAG console color depth"
        default BMDS_USJ_COLOR_TRUECOLOR
        help
            Colors the terminal on the other end of the serial port shows.
            The console can't detect it; output with more colors is
            rewritten to fit. Change it at run time with `term color`.

        config BMDS_USJ_COLOR_TRUECOLOR
            bool "24-bit (truecolor)"
        config BMDS_USJ_COLOR_256
            bool "256 colors"
        config BMDS_USJ_COLOR_16
            bool "16 colors"
        config BMDS_USJ_COLOR_NONE
            bool "No color"
    endchoice

endmenu
