setsid: the NOMMU re-exec runs setsid again, with all of its arguments

fork_or_rexec() got argv after the options were skipped, so the re-execed child ran the
command as an applet name ("ps: applet not found") or ran it without setsid(). Upstream 1.37.0
bug (BMDS, no MMU).

--- a/util-linux/setsid.c	2026-10-06 13:58:18.880530241 -0700
+++ b/util-linux/setsid.c	2026-10-06 13:58:18.940308864 -0700
@@ -36,6 +36,7 @@
 int setsid_main(int argc UNUSED_PARAM, char **argv)
 {
 	unsigned opt;
+	char **args = argv; /* NOMMU: the re-exec runs setsid again, so it needs all of it */
 
 	/* +: stop on first non-opt */
 	opt = getopt32(argv, "^+" "c" "\0" "-1"/* at least one arg */);
@@ -55,7 +56,7 @@
 	 * or if setsid is executed in backquotes (`setsid PROG`)...
 	 */
 	if (setsid() < 0) {
-		pid_t pid = fork_or_rexec(argv);
+		pid_t pid = fork_or_rexec(args);
 		if (pid != 0) {
 			/* parent */
