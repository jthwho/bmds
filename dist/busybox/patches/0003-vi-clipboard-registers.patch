-	char *reg[28];          // named register a-z, "D", and "U" 0-25,26,27
-	char regtype[28];       // buffer type: WHOLE, MULTI or PARTIAL
+	// BMDS: "+ and "* are the clipboard and the primary selection, kept in
+	// /dev/clip0 and /dev/clip0p (ordinary registers where those don't exist)
+#define CLIPreg 28
+#define PRIMreg 29
+	char *reg[30];          // named register a-z, "D", "U", "+" and "*" 0-25,26,27,28,29
+	char regtype[30];       // buffer type: WHOLE, MULTI or PARTIAL
 	char *mark[28];         // user marks points somewhere in text[]-  a-z and previous context ''
 #endif
 #if ENABLE_FEATURE_VI_USE_SIGNALS
@@ -1428,9 +1432,40 @@
 	reg[dest] = xstrndup(p, cnt + 1);
 	regtype[dest] = buftype;
 	free(oldreg);
+	if (dest == CLIPreg || dest == PRIMreg) {
+		// BMDS: the clipboard's file, if there is one
+		int fd = open(dest == CLIPreg ? "/dev/clip0" : "/dev/clip0p", O_WRONLY | O_TRUNC);
+		if (fd >= 0) {
+			full_write(fd, reg[dest], strlen(reg[dest]));
+			close(fd);
+		}
+	}
 	return p;
 }
 
+// BMDS: "+ and "* hold what the clipboard's file holds now (text ending in a
+// newline is whole lines, as Vim puts it)
+static void clip_reg(int r)
+{
+	char *p;
+	size_t n;
+
+	if (r != CLIPreg && r != PRIMreg)
+		return;
+	p = xmalloc_open_read_close(r == CLIPreg ? "/dev/clip0" : "/dev/clip0p", NULL);
+	if (p == NULL)
+		return;		// no such file: the register as it is
+	n = strlen(p);
+	free(reg[r]);
+	reg[r] = NULL;
+	if (n != 0) {
+		reg[r] = p;
+		regtype[r] = p[n - 1] == '\n' ? WHOLE : PARTIAL;
+	} else {
+		free(p);
+	}
+}
