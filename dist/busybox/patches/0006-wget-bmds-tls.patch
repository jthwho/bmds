wget: https:// on the kernel's TLS sockets (BMDS)

Without CONFIG_FEATURE_WGET_OPENSSL or _HTTPS, and with BMDS's <bmds/sys.h>, wget makes its
connection's socket a TLS client with tls_ctl (devplan/network.md §35d): the certificate is checked
against the system's roots (BusyBox's own TLS checks none), a refusal is said in words, and
--no-check-certificate lets one pass. No helper process, and no SHUT_WR after the request (it would
be close_notify).

--- a/networking/wget.c
+++ b/networking/wget.c
@@ -183,7 +183,19 @@
 #endif
 
 
-#define SSL_SUPPORTED (ENABLE_FEATURE_WGET_OPENSSL || ENABLE_FEATURE_WGET_HTTPS)
+/* BMDS: the kernel's TLS sockets (tls_ctl): the connection's own socket becomes TLS, its
+ * certificate checked against the system's roots; no helper process. */
+#if defined(__has_include)
+# if __has_include(<bmds/sys.h>)
+#  include <bmds/sys.h>
+#  define BMDS_TLS 1
+# endif
+#endif
+#ifndef BMDS_TLS
+# define BMDS_TLS 0
+#endif
+
+#define SSL_SUPPORTED (ENABLE_FEATURE_WGET_OPENSSL || ENABLE_FEATURE_WGET_HTTPS || BMDS_TLS)
 #define FTPS_SUPPORTED (ENABLE_FEATURE_WGET_FTP && ENABLE_FEATURE_WGET_HTTPS)
 
