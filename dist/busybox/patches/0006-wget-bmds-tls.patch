@@ -822,6 +834,51 @@
 }
 #endif
 
+#if BMDS_TLS && !ENABLE_FEATURE_WGET_OPENSSL && !ENABLE_FEATURE_WGET_HTTPS
+/* TLS on the connected socket @p fd for @p host: the kernel's handshake, its refusal in words. */
+static void bmds_start_tls(const char *host, int fd)
+{
+	bmds_tls_config_t config;
+	bmds_tls_info_t info;
+	char *servername, *p;
+	int r;
+
+	servername = xstrdup(host);
+	p = strrchr(servername, ':');
+	if (p) *p = '\0';
+	memset(&config, 0, sizeof(config));
+	config.size = sizeof(config);
+	config.server_name = servername;
+	if (option_mask32 & WGET_OPT_NO_CHECK_CERT)
+		config.flags = BMDS_TLS_NO_VERIFY;
+	r = bmds_tls_ctl(fd, BMDS_TLS_START, &config);
+	if (r == 0)
+		r = bmds_tls_ctl(fd, BMDS_TLS_HANDSHAKE, NULL);
+	if (r == -BMDS_EKEYREJECTED) {
+		const char *why = "it was refused";
+		memset(&info, 0, sizeof(info));
+		info.size = sizeof(info);
+		if (bmds_tls_ctl(fd, BMDS_TLS_INFO, &info) == 0) {
+			if (info.verify & BMDS_TLS_VERIFY_CLOCK)
+				why = "the clock isn't set, so its dates can't be checked";
+			else if (info.verify & BMDS_TLS_VERIFY_EXPIRED)
+				why = "it has expired";
+			else if (info.verify & BMDS_TLS_VERIFY_NOT_YET_VALID)
+				why = "it isn't valid yet";
+			else if (info.verify & BMDS_TLS_VERIFY_NAME)
+				why = "it is for another name";
+			else if (info.verify & BMDS_TLS_VERIFY_UNTRUSTED)
+				why = "it isn't from an authority this system trusts";
+		}
+		bb_error_msg_and_die("%s: TLS certificate refused: %s (--no-check-certificate to go on)",
+				servername, why);
+	}
+	if (r < 0)
+		bb_error_msg_and_die("%s: TLS: %s", servername, strerror(-r));
+	free(servername);
+}
+#endif
