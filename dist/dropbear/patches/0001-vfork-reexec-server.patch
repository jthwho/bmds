BMDS has no fork: the server's accept loop vforks and execs itself with the connection on
stdin (re-exec mode's -2), the child touching nothing of the parent's; DROPBEAR_VFORK_REEXEC
(localoptions.h) turns it on and re-exec mode with it (musl's fexecve needs /proc).

--- a/src/sysoptions.h
+++ b/src/sysoptions.h
@@ -42,7 +42,7 @@
 #endif
 
 /* Would probably work on freebsd but hasn't been tested */
-#if defined(HAVE_FEXECVE) && DROPBEAR_REEXEC && defined(__linux__)
+#if (defined(HAVE_FEXECVE) && DROPBEAR_REEXEC && defined(__linux__)) || DROPBEAR_VFORK_REEXEC
 #define DROPBEAR_DO_REEXEC 1
 #else
 #define DROPBEAR_DO_REEXEC 0
--- a/src/svr-main.c
+++ b/src/svr-main.c
@@ -123,6 +123,32 @@
 #endif /* INETD_MODE */
 
 #if NON_INETD_MODE
+#if DROPBEAR_VFORK_REEXEC
+/* The child of a connection without fork: a session of its own, the connection on stdin, the
+ * server run again (-2 childpipe). It only closes, dups and execs, in the child's own
+ * descriptors, and ends with exec or _exit: nothing of the parent's memory changes. In a
+ * function of its own, so no variable of the accept loop lives across the vfork. */
+static pid_t vfork_reexec(int childsock, int childpipe_read, const int *listensocks, size_t listensockcount,
+		const char *path, char **argv) {
+	pid_t pid = vfork();
+	if (pid == 0) {
+		size_t j;
+		(void)setsid();
+		for (j = 0; j < listensockcount; j++) {
+			(void)close(listensocks[j]);
+		}
+		(void)close(childpipe_read);
+		if (dup2(childsock, STDIN_FILENO) < 0) {
+			_exit(1);
+		}
+		(void)close(childsock);
+		execv(path, argv);
+		_exit(1);
+	}
+	return pid;
+}
+#endif
+
 static void main_noinetd(int argc, char ** argv, const char* multipath) {
 	fd_set fds;
 	unsigned int i, j;
