--- /dev/null
+++ b/libtomcrypt/src/headers/tomcrypt_bmds.h
@@ -0,0 +1,68 @@
+/* BMDS: the chip's AES and SHA engines through the kernel's crypto call (slot 112; BMDS's
+ * devplan/network.md §26). libtomcrypt's own code stays the fallback on a kernel without it.
+ * On by BMDS_CRYPTO_ENGINES (dist/dropbear/localoptions.h). */
+#ifndef TOMCRYPT_BMDS_H_
+#define TOMCRYPT_BMDS_H_
+
+#if BMDS_CRYPTO_ENGINES
+#include <bmds/sys.h>
+
+/* Nonzero if this kernel has the engines. */
+static inline int bmds_engine_present(void)
+{
+   return bmds_sys_has(BMDS_SYS_CRYPTO);
+}
+
+/* One call to the engines: 0, or a negative BMDS error. */
+static inline int bmds_engine_run(uint32_t algorithm, const unsigned char *key, unsigned long keylen,
+                                  unsigned char *state, const unsigned char *in, unsigned char *out,
+                                  unsigned long len)
+{
+   const bmds_crypto_op_t op = { sizeof(op), algorithm, key, (uint32_t)keylen, state, in, out, (uint32_t)len };
+   return bmds_crypto(&op);
+}
+
+/* HASH_PROCESS, but whole blocks go to blocks_name together (one call to the engine for all of
+ * a packet's), and a filled buffer too. */
+#define HASH_PROCESS_BLOCKS(func_name, blocks_name, state_var, block_size)                  \
+int func_name (hash_state * md, const unsigned char *in, unsigned long inlen)               \
+{                                                                                           \
+    unsigned long n;                                                                        \
+    int           err;                                                                      \
+    LTC_ARGCHK(md != NULL);                                                                 \
+    LTC_ARGCHK(in != NULL);                                                                 \
+    if (md-> state_var .curlen > sizeof(md-> state_var .buf)) {                             \
+       return CRYPT_INVALID_ARG;                                                            \
+    }                                                                                       \
+    if ((md-> state_var .length + inlen) < md-> state_var .length) {                        \
+      return CRYPT_HASH_OVERFLOW;                                                           \
+    }                                                                                       \
+    while (inlen > 0) {                                                                     \
+        if (md-> state_var .curlen == 0 && inlen >= block_size) {                           \
+           n = inlen - inlen % block_size;                                                  \
+           if ((err = blocks_name (md, in, n)) != CRYPT_OK) {                               \
+              return err;                                                                   \
+           }                                                                                \
+           md-> state_var .length += n * 8;                                                 \
+           in             += n;                                                             \
+           inlen          -= n;                                                             \
+        } else {                                                                            \
+           n = MIN(inlen, (block_size - md-> state_var .curlen));                           \
+           XMEMCPY(md-> state_var .buf + md-> state_var.curlen, in, (size_t)n);             \
+           md-> state_var .curlen += n;                                                     \
+           in             += n;                                                             \
+           inlen          -= n;                                                             \
+           if (md-> state_var .curlen == block_size) {                                      \
+              if ((err = blocks_name (md, md-> state_var .buf, block_size)) != CRYPT_OK) {  \
+                 return err;                                                                \
+              }                                                                             \
+              md-> state_var .length += 8*block_size;                                       \
+              md-> state_var .curlen = 0;                                                   \
+           }                                                                                \
+       }                                                                                    \
+    }                                                                                       \
+    return CRYPT_OK;                                                                        \
+}
+#endif /* BMDS_CRYPTO_ENGINES */
+
+#endif /* TOMCRYPT_BMDS_H_ */
