+#if BMDS_CRYPTO_ENGINES && !defined(ENCRYPT_ONLY)
+/* BMDS: ctr_encrypt's whole blocks on the chip's AES engine. libtomcrypt's counter is the last
+   block's (each block increments, then enciphers it), the engine's the next block's. Without the
+   engine, for an AES-192 key or a little-endian counter, block by block in software. Counters
+   are taken as the whole block wide (SSH's are: the descriptor isn't told the width). */
+static int bmds_aes_ctr(const unsigned char *pt, unsigned char *ct, unsigned long blocks,
+                        unsigned char *IV, int mode, symmetric_key *skey)
+{
+   unsigned char pad[16];
+   unsigned long b;
+   int x, err;
+
+   if (mode == CTR_COUNTER_BIG_ENDIAN && skey->rijndael.rawlen != 0 && bmds_engine_present()) {
+      for (x = 15; x >= 0 && ++IV[x] == 0; x--) {}
+      if (bmds_engine_run(BMDS_CRYPTO_AES_CTR, skey->rijndael.raw, (unsigned long)skey->rijndael.rawlen,
+                          IV, pt, ct, blocks * 16) == 0) {
+         for (x = 15; x >= 0 && IV[x]-- == 0; x--) {}
+         return CRYPT_OK;
+      }
+      for (x = 15; x >= 0 && IV[x]-- == 0; x--) {}
+   }
+   for (b = 0; b < blocks; b++, pt += 16, ct += 16) {
+      if (mode == CTR_COUNTER_LITTLE_ENDIAN) {
+         for (x = 0; x < 16 && ++IV[x] == 0; x++) {}
+      } else {
+         for (x = 15; x >= 0 && ++IV[x] == 0; x--) {}
+      }
+      if ((err = rijndael_ecb_encrypt(IV, pad, skey)) != CRYPT_OK) {
+         return err;
+      }
+      for (x = 0; x < 16; x++) {
+         ct[x] = pt[x] ^ pad[x];
+      }
+   }
+   zeromem(pad, sizeof(pad));
+   return CRYPT_OK;
+}
+#endif
+
 #endif
 
 
