# Shared build settings for BMDS components.
#
# Included from each BMDS component's CMakeLists.txt (both in the ESP-IDF
# build and in the host test build), so it must not depend on anything
# defined by the top-level project.

include_guard(GLOBAL)

# Applies the BMDS language standard and warning policy to a target.
#
# ESP-IDF builds everything with its own (newer) -std; BMDS code is written
# to C++20, so the BMDS flag is added after IDF's and wins.
function(bmds_target_options target)
        get_target_property(target_type ${target} TYPE)
        if(target_type STREQUAL "INTERFACE_LIBRARY")
                return()
        endif()
        target_compile_options(${target} PRIVATE
                $<$<COMPILE_LANGUAGE:CXX>:-std=gnu++20 -fno-exceptions -fno-rtti -Wnon-virtual-dtor>
                $<$<COMPILE_LANGUAGE:C>:-std=gnu17>
                -Wall -Wextra -Werror -Wshadow)
endfunction()

# A built-in program's icons (devplan/gui.md §4j): the PNGs in ARGN as a header
# named HEADER (in the target's binary directory, on its include path) defining
# the ProgramIcon array VAR for BMDS_PROGRAM_ICONS.
function(bmds_embed_icons target header var)
        set(script ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/embedicons.py)
        if(COMMAND idf_build_get_property)
                idf_build_get_property(python PYTHON)
        else()
                find_package(Python3 REQUIRED COMPONENTS Interpreter)
                set(python ${Python3_EXECUTABLE})
        endif()
        set(out ${CMAKE_CURRENT_BINARY_DIR}/${header})
        add_custom_command(OUTPUT ${out}
                           COMMAND ${python} ${script} ${out} ${var} ${ARGN}
                           DEPENDS ${script} ${ARGN}
                           VERBATIM)
        target_sources(${target} PRIVATE ${out})
        target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction()

# The public keys update packages may be signed with (devplan/update.md §2, keys/README.md), as
# HEADER (in the target's binary directory, on its include path): the UpdatePackage::Key
# initializers of keys/release.pub's keys, and keys/dev.pub's too unless RELEASE_ONLY. A release
# build without a release key fails here. Configure reruns when keys/ changes.
function(bmds_update_keys target header release_only)
        set(dir ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../keys)
        set(files ${dir}/release.pub)
        if(NOT release_only)
                list(APPEND files ${dir}/dev.pub)
        endif()
        set(body "// Generated by bmds_update_keys() (cmake/bmds.cmake) from keys/: do not edit.\n")
        set(count 0)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dir})
        foreach(file ${files})
                if(NOT EXISTS ${file})
                        continue()
                endif()
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
                file(STRINGS ${file} lines REGEX "^ed25519 ")
                foreach(line ${lines})
                        if(NOT line MATCHES "^ed25519 ([0-9a-fA-F]+)( |$)")
                                message(FATAL_ERROR "${file}: not a key: ${line}")
                        endif()
                        string(LENGTH "${CMAKE_MATCH_1}" length)
                        if(NOT length EQUAL 64)
                                message(FATAL_ERROR "${file}: a key is 64 hex digits: ${line}")
                        endif()
                        string(REGEX REPLACE "(..)" "0x\\1," bytes "${CMAKE_MATCH_1}")
                        get_filename_component(name ${file} NAME)
                        string(APPEND body "{{${bytes}}}, // ${name}\n")
                        math(EXPR count "${count} + 1")
                endforeach()
        endforeach()
        if(count EQUAL 0)
                message(FATAL_ERROR "Release acceptance mode (CONFIG_BMDS_UPDATE_KEYS_RELEASE) "
                                    "and no release key in keys/release.pub (keys/README.md)")
        endif()
        set(out ${CMAKE_CURRENT_BINARY_DIR}/${header})
        file(WRITE ${out}.new "${body}")
        configure_file(${out}.new ${out} COPYONLY)
        target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction()
