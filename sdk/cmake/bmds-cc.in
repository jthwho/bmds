#!/bin/sh
# bmds-cc: compiles and links BMDS programs (SDK 2: static musl) for build
# systems other than CMake: CC=/path/to/bmds-cc make. Generated by
# BmdsProgram.cmake; build the target bmds_libs first.
#
# Links like bmds_add_program, into an ELF with everything (strip it for the
# card: riscv32-esp-elf-objcopy --strip-unneeded in out). BMDS_STACK=bytes
# sets the program's stack (default: the kernel's). libbmds.a comes first as
# well, so that _start, and with it main, is wanted before the program's own
# archives are searched (BusyBox keeps main in one).

GCC="@CMAKE_C_COMPILER@"
ARCH="@BMDS_ARCH_FLAGS@ -mcmodel=medany -mno-relax -ffunction-sections -fdata-sections"
INC="-nostdinc -isystem @BMDS_LIBC_INCLUDE@ -isystem @BMDS_GCC_INCLUDE@ -I@BMDS_SDK_DIR@/include"

link=1
for a in "$@"; do
        case "$a" in
                -c|-S|-E|-M|-MM) link=0 ;;
                -r) link=r ;;
        esac
done
if [ $link = 0 ]; then exec "$GCC" $ARCH $INC "$@"; fi
if [ $link = r ]; then exec "$GCC" $ARCH -nostdlib "$@"; fi
exec "$GCC" $ARCH $INC -static -nostdlib -L@BMDS_LIBC_LIB@ -u _start -T @BMDS_SDK_DIR@/ld/bmds.ld \
        -Wl,--emit-relocs -Wl,--no-relax -Wl,--gc-sections -Wl,-z,max-page-size=512 -Wl,-z,common-page-size=512 \
        -Wl,--no-warn-rwx-segments -Wl,--defsym=__bmds_stack_size=${BMDS_STACK:-0} \
        -lbmds "$@" -Wl,--start-group -lbmds -lc @BMDS_LIBGCC@ -Wl,--end-group
