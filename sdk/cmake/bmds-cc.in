#!/bin/sh
# @BMDS_CC_NAME@: compiles and links BMDS programs (static musl) for build
# systems other than CMake: CC=/path/to/bmds-cc make, CXX=/path/to/bmds-c++
# (C++ without exceptions, RTTI or libstdc++: sdk/README.md). Generated by
# BmdsProgram.cmake; build the target bmds_libs first.
#
# Links like bmds_add_program, into an ELF with everything (strip it for the
# card: riscv32-esp-elf-objcopy --strip-unneeded in out). BMDS_STACK=bytes
# sets the program's stack (default: the kernel's); BMDS_DISPLAY=1 marks it as
# drawing to the screen continuously (BMDS_PROGRAM_DISPLAY: the kernel starts it
# away from the display's core). libbmds.a comes first as
# well, so that _start, and with it main, is wanted before the program's own
# archives are searched (BusyBox keeps main in one).

GCC="@BMDS_CC_DRIVER@"
# -g: the unstripped build (bmds-fault, bmds-prof, GDB) has files and lines; GCC's code is the same
# with it, and what goes on the card is stripped (tools/bmds-dist).
ARCH="@BMDS_ARCH_FLAGS@ -mcmodel=medany -mno-relax -ffunction-sections -fdata-sections -g"
# Paths by fixed names (devplan/debuginfo.md §3a), as bmds_add_program's: the SDK as /sdk/..., its
# build (musl's generated headers) as /build/..., the toolchain's headers as /riscv32-esp-elf/..., so
# the same sources give the same build-id anywhere. BMDS_PREFIX_MAPS adds the caller's folders (OLD=NEW,
# space-separated, the outermost first: its tree, sources, build folder). GCC uses the last map that
# matches, so the caller's go first: a folder of theirs holding the SDK leaves the SDK's names.
for map in ${BMDS_PREFIX_MAPS:-}; do ARCH="$ARCH -ffile-prefix-map=$map"; done
ARCH="$ARCH@BMDS_CC_PREFIX_MAPS@"
INC="-nostdinc @BMDS_CC_LANGUAGE_FLAGS@ -isystem @BMDS_LIBC_INCLUDE@ -isystem @BMDS_GCC_INCLUDE@ -I@BMDS_SDK_DIR@/include"

link=1
for a in "$@"; do
        case "$a" in
                -c|-S|-E|-M|-MM) link=0 ;;
                -r) link=r ;;
        esac
done
if [ $link = 0 ]; then exec "$GCC" $ARCH $INC "$@"; fi
if [ $link = r ]; then exec "$GCC" $ARCH -nostdlib "$@"; fi
# The link runs through bmds-link, which gathers the bytes the loader patches at the image's end
# (devplan/programs.md §14.3).
exec "@Python3_EXECUTABLE@" "@BMDS_SDK_DIR@/tools/bmds-link" "$GCC" $ARCH $INC -static -nostdlib -L@BMDS_LIBC_LIB@ -u _start -T @BMDS_SDK_DIR@/ld/bmds.ld \
        -Wl,--emit-relocs -Wl,--build-id=sha1 -Wl,--no-relax -Wl,--gc-sections -Wl,-z,max-page-size=512 -Wl,-z,common-page-size=512 \
        -Wl,--no-warn-rwx-segments -Wl,--defsym=__bmds_stack_size=${BMDS_STACK:-0} \
        -Wl,--defsym=__bmds_program_flags=${BMDS_DISPLAY:-0} \
        -lbmds "$@" -Wl,--start-group -lbmdsgame -lbmds3d -lbmdsgui -lbmdsbench -lbmds -lc @BMDS_LIBGCC@ -Wl,--end-group
