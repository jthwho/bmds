# Program images: never converted or diffed as text.
*.elf binary
# PNGs (the icons, devplan/gui.md §4h) are kept in Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
# The SVOX Pico voices (devplan/speech.md) are kept in Git LFS.
thirdparty/svox-pico/lang/*.bin filter=lfs diff=lfs merge=lfs -text
# The fonts (devplan/fonts.md): IBM Plex's TrueType files, as released, kept in Git LFS.
thirdparty/plex/fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
# The font tests' own small fonts (tests/host/fonts): binary, not in LFS.
tests/host/fonts/*.ttf binary
tests/host/fonts/fuzz/*.ttf binary
# The OPL banks (devplan/audio.md §26): binary, small, not in LFS.
thirdparty/opl-banks/*.op2 binary
