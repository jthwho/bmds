root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,cc}]
indent_style = space
indent_size = 8
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,csv}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[Kconfig*]
indent_style = tab
